{
  "dfx": "0.29.2",
  "canisters": {
    "internet_identity": {
      "type": "custom",
      "wasm": "internet_identity/internet_identity_dev.wasm.gz",
      "candid": "internet_identity/internet_identity.did",
      "frontend": {},
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      }
    },
    "icp_app_backend": {
      "main": "src/backend/main.mo",
      "type": "motoko",
      "args": "--hide-warnings"
    },
    "icp_app_frontend": {
      "dependencies": [
        "icp_app_backend"
      ],
      "source": [
        "src/frontend/dist"
      ],
      "type": "assets",
      "workspace": "src/frontend"
    }
  },
  "networks": {
    "ic": {
      "providers": [
        "https://icp-api.io",
        "https://ic0.app",
        "https://icp0.io"
      ]
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "post_deploy": [
    "echo NODE_ENV is $NODE_ENV"
  ],
  "output_env_file": ".env",
  "version": 1
}