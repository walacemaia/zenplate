{
  "name": "icp_app",
  "author": "Walace Maia",
  "version": "0.1.0-SNAPSHOT",
  "description": "Template base do ecossistema icp-workspace: backend Motoko sobre cached-db + frontend React/MUI, sem conteudo de dominio de produto. Gerado a partir do Zenquest via icp-skills (skill gerar-novo-projeto.md).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "clean": "icp network stop; rm -rf .icp/cache && icp network start -d",
    "start:safe": "icp network start -d",
    "deploy:safe": "icp deploy",
    "deploy:safe:backend": "icp deploy icp_app_backend"
  },
  "workspaces": [
    "src/frontend"
  ],
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "remark-gfm": "^4.0.1"
  }
}